# Target application
TARGET_URL=https://cb3newsmonitoringdashboard.lovable.app/lokal/langtad

# Requested interaction counts
LIKE_CLICKS=1000
SHARE_CLICKS=1000

# Conservative pacing (milliseconds)
DELAY_BETWEEN_CLICKS_MS=2000
BATCH_SIZE=25
BATCH_COOLDOWN_MS=10000

# Only this known telemetry endpoint is exempted from fatal HTTP 429 handling
TELEMETRY_429_PATHS=/__l5e/trackevents
TELEMETRY_429_BACKOFF_MS=30000
MAX_TELEMETRY_429=5

# Console errors are logged as warnings by default; set true to fail on any console error
FAIL_ON_CONSOLE_ERROR=false

# Timeouts and safe failure limits
NAVIGATION_TIMEOUT_MS=30000
ACTION_TIMEOUT_MS=10000
STATE_TIMEOUT_MS=5000
RESPONSIVE_TIMEOUT_MS=5000
MAX_CONSECUTIVE_FAILURES=3

# Reporting
SCREENSHOT_MAX_COUNT=20
HEADLESS=true
EXTERNAL_NAVIGATION_TIMEOUT_MS=10000
EXTERNAL_NAVIGATION_DETECT_MS=500
